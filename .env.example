# Exemplo: copiar valores para variáveis de ambiente. Não carregado automaticamente.
LIVE_USERNAME=instrutor
# Gere localmente: python ai-service/password_hash.py
LIVE_PASSWORD_HASH=
LIVE_ORIGIN=http://127.0.0.1:8000
LIVE_BIND=127.0.0.1
LIVE_PORT=8000
LIVE_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
LIVE_SESSION_SECONDS=900
LIVE_CAMERA_INDEX=0
LIVE_WIDTH=960
LIVE_HEIGHT=540
LIVE_FPS=12
# Acesso LAN exige HTTPS e certificados institucionais:
# LIVE_ORIGIN=https://192.168.10.20:8000
# LIVE_BIND=192.168.10.20
# LIVE_ALLOWED_NETWORKS=192.168.10.0/24
# LIVE_TLS_CERT=/caminho/certificado.pem
# LIVE_TLS_KEY=/caminho/chave.pem
